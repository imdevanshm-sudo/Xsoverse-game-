# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Required for Gemini AI API calls.
#
# On Vercel: add as VITE_GEMINI_API_KEY in Project Settings → Environment Variables
#   (VITE_ prefix is required for Vite to expose it to the browser bundle)
#
# On AI Studio: set as GEMINI_API_KEY — it is injected automatically at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── App URL ─────────────────────────────────────────────────────────────────
# The URL where this app is hosted.
# On Vercel this is set automatically via the VERCEL_URL system env var.
# On AI Studio it is injected as APP_URL with the Cloud Run service URL.
APP_URL="MY_APP_URL"
